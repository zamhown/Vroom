    {
      "name": "export.scan",
      "description": {
        "en": "Scan source titles, tracks and chapters; returns a job ID.",
        "zh-CN": "扫描标题、轨道和章节，返回任务 ID。"
      },
      "arguments": "{filmId?:string,partId?:string,sourcePath?:string}",
      "mutates": false
    },
    {
      "name": "export.preview",
      "description": {
        "en": "Freeze export inputs. Read media-export.schema.json first.",
        "zh-CN": "验证并冻结导出目标和设置。"
      },
      "arguments": "ExportRequest (media-export.schema.json)",
      "mutates": false
    },
    {
      "name": "export.commit",
      "description": {
        "en": "Queue an exact reviewed export preview.",
        "zh-CN": "提交已审阅的原始导出预览。"
      },
      "arguments": "{previewToken:string}",
      "mutates": true
    },
    {
      "name": "export.preset.resolve",
      "description": {
        "en": "Resolve the effective preset with overrides using the same validation as export.",
