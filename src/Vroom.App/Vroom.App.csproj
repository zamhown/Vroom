<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="SpectrumTheme.props" />

  <PropertyGroup>
    <!-- Desktop targets build by default. Mobile targets are experimental and opt-in. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="'$(VroomMobile)' == 'true'"
      >$(TargetFrameworks);net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(VroomTargetFramework)' != ''">$(VroomTargetFramework)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Vroom.App</RootNamespace>
    <MauiVersion>10.0.110</MauiVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Display name -->
    <ApplicationTitle>Vroom</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>app.vroom.local</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>$(VroomVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(VroomBuildNumber)</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'"
      >15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion
      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
      >17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
      >21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"
      >10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"
      >10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <!-- Keep every assembly's reflected contracts and Objective-C entry points.
         TrimMode=copy alone only selects the framework action on this Apple SDK. -->
    <PublishTrimmed>true</PublishTrimmed>
    <MtouchLink>None</MtouchLink>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon
      Include="Resources\AppIcon\appicon.svg"
      ForegroundFile="Resources\AppIcon\appiconfg.svg"
      Color="$(SpectrumBackground)"
    />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="$(SpectrumBackground)" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Vroom.Core/Vroom.Core.csproj" />
    <PackageReference
      Include="LLamaSharp.Backend.Cpu"
      GeneratePathProperty="true"
      Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
    />
  </ItemGroup>

  <!-- NuGet has osx native assets, but Catalyst does not inherit that RID. Keep the
       libraries and their sibling dependencies together, including the Metal source. -->
  <Target
    Name="PrepareMacNativeLibraries"
    BeforeTargets="ProcessMauiAssets"
    Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
  >
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/prepare-llama-macos.mjs&quot; &quot;$(PkgLLamaSharp_Backend_Cpu)&quot; &quot;$(IntermediateOutputPath)llama&quot;" />
    <ItemGroup>
      <_VroomLlamaArm Include="$(IntermediateOutputPath)llama/arm64/*" />
      <_VroomLlamaIntel Include="$(IntermediateOutputPath)llama/x64/*" />
      <MauiAsset
        Include="@(_VroomLlamaArm)"
        LogicalName="runtime/llama/arm64/%(_VroomLlamaArm.Filename)%(_VroomLlamaArm.Extension)"
      />
      <MauiAsset
        Include="@(_VroomLlamaIntel)"
        LogicalName="runtime/llama/x64/%(_VroomLlamaIntel.Filename)%(_VroomLlamaIntel.Extension)"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="BuildMacVideoPresenter"
    BeforeTargets="PrepareForBuild;_SanitizeNativeReferences;ProcessMauiAssets"
    Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
  >
    <PropertyGroup>
      <VroomMacArchitecture Condition="'$(RuntimeIdentifier)' == 'maccatalyst-arm64'">arm64</VroomMacArchitecture>
      <VroomMacArchitecture Condition="'$(VroomMacArchitecture)' == ''">x64</VroomMacArchitecture>
      <VroomMacNativeDirectory>$(MSBuildProjectDirectory)/../../runtime/host/$(VroomMacArchitecture)</VroomMacNativeDirectory>
    </PropertyGroup>
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/build-macos-native.mjs&quot; --arch=$(VroomMacArchitecture)" />
    <ItemGroup>
      <NativeReference
        Include="$(VroomMacNativeDirectory)/libvroom-video.a"
        Kind="Static"
        ForceLoad="true"
        SmartLink="false"
        Frameworks="UIKit Foundation Metal QuartzCore IOSurface"
      />
      <MauiAsset
        Include="$(VroomMacNativeDirectory)/libvroom-window.dylib"
        LogicalName="runtime/host/libvroom-window.dylib"
      />
    </ItemGroup>
  </Target>

  <Target
    Name="LocateApplePublicResources"
    BeforeTargets="_ComputePublishLocation"
    Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
  >
    <!-- Metadata on Core's transitive Content items is not preserved by the SDK copy list. -->
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('resources/'))">
        <PublishFolderType>Resource</PublishFolderType>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
