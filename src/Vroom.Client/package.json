{
  "name": "vroom-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node ../../scripts/sync-branding.mjs --check",
    "build": "tsc -b && vite build && node scripts/sync-native-theme.mjs && node scripts/sync-assets.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@formatjs/intl-localematcher": "0.10.1",
    "@internationalized/date": "3.12.4",
    "@react-spectrum/s2": "1.8.2",
    "hls.js": "1.7.4",
    "intl-messageformat": "12.1.4",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lightningcss": "1.33.0",
    "node": "26.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-parcel-macros": "0.2.0",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
